# Local development defaults. Copy to `.env` and adjust as needed.
# Do not put production secrets in this file.

MINIRUST_ENV=development
MINIRUST_LOG=info

MINIRUST_API_HOST=127.0.0.1
MINIRUST_API_PORT=3000

MINIRUST_WEB_HOST=127.0.0.1
MINIRUST_WEB_PORT=3001

# Optional. Accepted by configuration, unused by the current baseline.
# MariaDB is accessed through SQLx's `mysql` driver.
# MINIRUST_DATABASE_URL=mysql://minirust@127.0.0.1:3306/minirust

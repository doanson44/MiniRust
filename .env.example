# Local development defaults. Copy to .env and adjust as needed.
# Do not put production secrets in this file.

MINIRUST_ENV=development
MINIRUST_LOG=info
MINIRUST_LOG_DIR=logs

MINIRUST_API_HOST=127.0.0.1
MINIRUST_API_PORT=3000

MINIRUST_WEB_HOST=127.0.0.1
MINIRUST_WEB_PORT=3001

# MariaDB connection parts. MINIRUST_DATABASE_URL, when set, overrides all of them.
# Wrap a value in single quotes to keep characters like $ literal (dotenvy expands $ otherwise).
MINIRUST_DB_HOST=127.0.0.1
MINIRUST_DB_PORT=3306
MINIRUST_DB_NAME=minirust
MINIRUST_DB_USER=minirust
MINIRUST_DB_PASSWORD=minirust
MINIRUST_DB_MAX_CONNECTIONS=5

# Optional full-URL override, e.g. mysql://minirust:minirust@127.0.0.1:3306/minirust
# MINIRUST_DATABASE_URL=

# Optional bootstrap admin overrides for local development.
MINIRUST_ADMIN_EMAIL=
MINIRUST_ADMIN_OTP=

MINIRUST_AUTH_SECRET=
